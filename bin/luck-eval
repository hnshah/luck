#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODEL="${LUCK_TEST_MODEL:-qwen2.5:32b}"
MODE="quick"

if [[ "${1:-}" == "--full" ]]; then
  MODE="full"
fi

cd "$ROOT"

echo "1/5 selftest"
LUCK_TEST_MODEL="$MODEL" bin/luck-selftest

echo "2/5 fast sample"
cat > /tmp/luck-eval-context.md <<'EOF'
Goal: make an AI reporting workflow reliable.
Current state: high-quality reports, recurring demand, but a senior operator rescues hidden steps.
Manual rescue: malformed files, retrying model calls, final HTML inspection.
Compounding loop: each run should create reusable QA checks and template improvements.
Known failure: heroic treadmill.
EOF
bin/luck-check --name "Eval workflow" --file /tmp/luck-eval-context.md --mode fast --model "$MODEL" > /tmp/luck-eval-fast.md
bin/luck-lint --mode fast --file /tmp/luck-eval-fast.md

echo "3/5 json sample"
bin/luck-check --name "Eval workflow" --file /tmp/luck-eval-context.md --mode json --model "$MODEL" --output /tmp/luck-eval.json >/dev/null
bin/luck-lint --mode json --file /tmp/luck-eval.json

echo "4/5 verdict dry-run"
if [[ -d /Users/bobshah/.openclaw/ren-workspace/verdict ]]; then
  node /Users/bobshah/.openclaw/ren-workspace/verdict/dist/cli/index.js run     -c /Users/bobshah/.openclaw/ren-workspace/verdict/verdict.yaml     -p "$ROOT/evals/luck-runtime-effectiveness.yaml"     --dry-run --no-store >/tmp/luck-verdict-dryrun.log
else
  echo "verdict checkout not found; skipping"
fi

if [[ "$MODE" == "full" ]]; then
  echo "5/5 full verdict eval"
  if [[ -d /Users/bobshah/.openclaw/ren-workspace/verdict ]]; then
    node /Users/bobshah/.openclaw/ren-workspace/verdict/dist/cli/index.js run       -c /tmp/luck-runtime-eval/verdict.yaml       -p "$ROOT/evals/luck-runtime-effectiveness.yaml"       --no-store --json >/tmp/luck-runtime-full-eval.json
  else
    echo "verdict checkout not found; skipping"
  fi
else
  echo "5/5 full verdict eval skipped (use --full)"
fi

echo "luck eval ok"
