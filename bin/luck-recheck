#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LEDGER = ROOT / "dogfood" / "ledger.jsonl"


def load_entries(project: str) -> list[dict]:
    if not LEDGER.exists():
        raise SystemExit(f"No ledger found: {LEDGER}")
    entries = []
    for line in LEDGER.read_text().splitlines():
        if not line.strip():
            continue
        entry = json.loads(line)
        if entry.get("project") == project:
            entries.append(entry)
    if len(entries) < 2:
        raise SystemExit(f"Need at least 2 ledger entries for project: {project}")
    return entries


def main() -> None:
    parser = argparse.ArgumentParser(description="Compare latest two Luck ledger entries for a project.")
    parser.add_argument("--project", required=True)
    args = parser.parse_args()

    entries = load_entries(args.project)
    before, after = entries[-2], entries[-1]
    b = before["assessment"]
    a = after["assessment"]

    comparison = {
        "project": args.project,
        "before_timestamp": before["timestamp"],
        "after_timestamp": after["timestamp"],
        "before_constraint": b.get("binding_constraint"),
        "after_constraint": a.get("binding_constraint"),
        "constraint_changed": b.get("binding_constraint") != a.get("binding_constraint"),
        "before_failure_mode": b.get("failure_mode"),
        "after_failure_mode": a.get("failure_mode"),
        "before_next_test": b.get("next_test"),
        "after_next_test": a.get("next_test"),
        "after_do_now": a.get("do_now"),
    }
    print(json.dumps(comparison, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()

