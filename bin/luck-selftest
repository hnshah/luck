#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODEL="${LUCK_TEST_MODEL:-qwen2.5:7b}"
TMPDIR="${TMPDIR:-/tmp}/luck-selftest"

mkdir -p "$TMPDIR"

cat > "$TMPDIR/workflow.md" <<'EOF'
Goal: make a reporting workflow reliable.
Current state: output quality is high and demand is recurring.
Manual rescue points: one senior operator remembers hidden steps, fixes malformed intermediate files, retries failed model calls, and manually inspects final HTML.
Active demand: weekly customer-facing reports.
Maintenance burden: prompts and templates drift.
Compounding loop: each run should produce reusable QA checks and template improvements, but today learnings stay in the operator's head.
Known failure: heroic manual rescue does not scale.
EOF

echo "1/4 help"
"$ROOT/bin/luck-check" --help >/dev/null

echo "2/4 fast mode"
"$ROOT/bin/luck-check" --name "Selftest workflow" --file "$TMPDIR/workflow.md" --mode fast --model "$MODEL" > "$TMPDIR/fast.md"
grep -qi "Luck constraint" "$TMPDIR/fast.md"
grep -qi "Failure mode" "$TMPDIR/fast.md"
grep -qi "Next test" "$TMPDIR/fast.md"

echo "3/4 json mode"
"$ROOT/bin/luck-check" --name "Selftest workflow" --file "$TMPDIR/workflow.md" --mode json --model "$MODEL" --output "$TMPDIR/result.json" >/dev/null
node -e '
const fs = require("fs");
const x = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
const required = ["verdict","binding_constraint","binding_constraint_summary","failure_mode","next_test","do_now","do_next","defer_or_stop","scores"];
for (const k of required) {
  if (!(k in x)) throw new Error("missing " + k);
  if (k !== "scores" && !String(x[k]).trim()) throw new Error("empty " + k);
}
for (const k of ["solvency","demand_coupling","adoption_friction","compounding_loop","circulation","integration","timing"]) {
  if (!(k in x.scores)) throw new Error("missing score " + k);
}
' "$TMPDIR/result.json"

echo "4/4 templates"
test -f "$ROOT/templates/repo.md"
test -f "$ROOT/templates/workflow.md"
test -f "$ROOT/templates/product.md"
test -f "$ROOT/templates/strategy.md"
test -f "$ROOT/templates/personal-decision.md"

echo "luck selftest ok"

